         if(isset($_SESSION['user'])){
             echo "<div class='user-welcome'>Bienvenido, <strong>" . htmlspecialchars($_SESSION['user']->getUserName()) . "</strong></div>";
             echo "<a href='index.php?accion=logout' class='logout-link'>Cerrar sesión</a><br><hr>";
