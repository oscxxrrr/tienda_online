        // CATÁLOGO DE PRODUCTOS (solo si hay sesión)
        if(isset($_SESSION['user'])){
            if(!empty($productArray)){
                echo "<div class='product-grid'>";
                foreach($productArray as $producto){
                    echo "<div class='product-card'>";
                    echo "<h3>" . htmlspecialchars($producto->getNombre()) . "</h3>";
                    echo "<p class='product-desc'>" . htmlspecialchars($producto->getDescripcion()) . "</p>";
                    echo "<p class='product-price'>" . number_format($producto->getPrecioActual(), 2) . " &euro;</p>";
                    echo "<p class='product-stock'>Stock: " . $producto->getStock() . "</p>";
                    echo "<a href='index.php?accion=addCarrito&id=" . $producto->getId() . "' class='btn-primary'>A&ntilde;adir al carrito</a>";
                    echo "</div>";
                }
                echo "</div>";
            } else {
                echo "<p>No hay productos disponibles.</p>";
            }
